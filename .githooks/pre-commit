#!/bin/sh
set -eu

gitleaks_bin=$(command -v gitleaks || true)
if [ -z "$gitleaks_bin" ] && [ -x "$HOME/.local/bin/gitleaks" ]; then
    gitleaks_bin="$HOME/.local/bin/gitleaks"
fi

if [ -z "$gitleaks_bin" ]; then
    printf '%s\n' 'Commit blocked: install Gitleaks (on macOS: brew install gitleaks).' >&2
    exit 1
fi

# Scan the index, including partially staged files, without printing secret values.
exec "$gitleaks_bin" git --pre-commit --staged --redact=100 --no-banner --no-color
